{
  "expo": {
    "name": "Agent Hub",
    "slug": "agent-hub",
    "version": "0.4.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "agenthub",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.toyan.agenthub",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/icon.png",
          "imageWidth": 140
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "レシートを撮影するためにカメラを使います",
          "photosPermission": "レシートの写真を選ぶために写真を使います"
        }
      ],
      ["expo-video", {"supportsBackgroundPlayback": true, "supportsPictureInPicture": true}],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
